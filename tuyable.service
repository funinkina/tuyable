# Pi: cp tuyable.service ~/.config/systemd/user/ && systemctl --user enable --now tuyable
[Unit]
Description=Tuyable lamp web app (port 8080)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/tuyable
ExecStart=%h/.local/bin/uv run -q server.py 8080
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/tuyable/server.log
StandardError=inherit

[Install]
WantedBy=default.target
